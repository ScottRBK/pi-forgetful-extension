+const MARKER_GRAMMAR = new RegExp(
+	`^${CHECKPOINT_MARKER_PREFIX.replace(/[[\]]/g, "\\$&")}[^\\s:\\]]+:`
+	+ "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\]$",
+);
+
+function wireText(item: unknown): string[] {
+	if (!isJsonObject(item) || !Array.isArray(item.content)) return [];
+	return item.content.flatMap((part) =>
+		isJsonObject(part) && typeof part.text === "string" ? [part.text] : []);
+}
+
+/** The marker text when `item` is exactly one user input_text holding a complete marker. */
+function wholeMarkerText(item: unknown): string | undefined {
+	if (!isJsonObject(item) || item.role !== "user" || !Array.isArray(item.content)) {
+		return undefined;
+	}
+	const part = item.content[0];
+	if (item.content.length !== 1 || !isJsonObject(part) || part.type !== "input_text") {
+		return undefined;
+	}
+	return typeof part.text === "string" && MARKER_GRAMMAR.test(part.text) ? part.text : undefined;
+}
+
+/**
+ * Drops request items that are exactly a complete marker (a bridge nobody will resolve) and
+ * leaves everything else, including text that merely mentions the marker prefix, untouched.
+ * Returns the payload itself when there is nothing to drop.
+ */
+export function dropStrayCheckpointMarkers(payload: JsonObject): JsonObject {
+	if (!Array.isArray(payload.input)) return payload;
+	const input = payload.input.filter((item) => wholeMarkerText(item) === undefined);
+	return input.length === payload.input.length ? payload : { ...payload, input };
+}
+
+/**
+ * Swaps the one exact marker item for the replacement history, leaving every other request item
+ * and field untouched. Other complete markers (stale ones) are dropped. Returns undefined when
+ * the current marker is missing, duplicated or altered.
+ */
+export function swapCheckpointMarker(
+	payload: JsonObject,
+	marker: string,
+	replacementHistory: ResponseItem[],
+): JsonObject | undefined {
+	if (!Array.isArray(payload.input)) return undefined;
+	const input: unknown[] = payload.input;
+	const carriers = input.flatMap((item, index) =>
+		wireText(item).some((text) => text.includes(marker)) ? [index] : []);
+	const at = carriers[0];
+	if (carriers.length !== 1 || at === undefined || wholeMarkerText(input[at]) !== marker) {
+		return undefined;
+	}
+
+	const next: JsonObject = {
+		...payload,
+		input: input.flatMap((item, index) => {
+			if (index === at) return replacementHistory.map(cloneItem);
+			return wholeMarkerText(item) === undefined ? [item] : [];
+		}),
+	};
+	delete next.messages;
+	delete next.previous_response_id;
+	return next;
+}
