+// ---- Checkpoint marker ------------------------------------------------------------------------
+//
+// Pi's `context` event lets other extensions add or remove messages, but the provider request is
+// built from those messages afterwards. To keep their changes, the context hook swaps the
+// checkpoint (and the saved messages it already covers) for one transient marker message. The
+// request hook later swaps that marker for the checkpoint's replacement history.
+
+type ContextMessage = SessionProjection["messages"][number];
+
+export const CHECKPOINT_MARKER_PREFIX = "[codex-native-checkpoint:";
+
+export function checkpointMarkerText(entryId: string, nonce: string): string {
+	return `${CHECKPOINT_MARKER_PREFIX}${entryId}:${nonce}]`;
+}
+
+export type MarkerPlan = { ok: true; messages: ContextMessage[] } | { ok: false; reason: string };
+
+function canonicalJson(value: unknown): string {
+	if (Array.isArray(value)) return `[${value.map(canonicalJson).join(",")}]`;
+	if (isJsonObject(value)) {
+		const keys = Object.keys(value).filter((key) => value[key] !== undefined).sort();
+		const fields = keys.map((key) => `${JSON.stringify(key)}:${canonicalJson(value[key])}`);
+		return `{${fields.join(",")}}`;
+	}
+	return JSON.stringify(value) ?? "null";
+}
+
+function messageIdentity(message: ContextMessage): string {
+	return `${message.role}|${(message as JsonObject).timestamp}`;
+}
+
+function messageKey(message: ContextMessage): string {
+	return `${messageIdentity(message)}|${shortHash(canonicalJson(message))}`;
+}
+
+/**
+ * Replaces the checkpoint summary and the saved messages the checkpoint already covers with one
+ * marker message, leaving every other message (other extensions' additions, edited tail) alone.
+ *
+ * Covered messages are matched by role, timestamp and content, counted as a multiset. A covered
+ * message another hook already removed stays removed. If one was edited, or duplicates make the
+ * match ambiguous, the result is `ok: false` so the caller can fall back safely.
+ */
+export function placeCheckpointMarker(params: {
+	messages: ContextMessage[];
+	projection: SessionProjection;
+	branch: SessionEntry[];
+	checkpoint: NativeCheckpoint;
+	marker: string;
+}): MarkerPlan {
+	const { projection, branch, checkpoint } = params;
+	const boundary = projection.entries[0]?.sourceEntry;
+	if (boundary?.type !== "compaction" || boundary.id !== checkpoint.entryId) {
+		return { ok: false, reason: "the checkpoint is not the active compaction boundary" };
+	}
+
+	const branchIndex = new Map(branch.map((entry, index) => [entry.id, index]));
+	const covered = new Map<string, { message: ContextMessage; count: number }>();
+	const later = new Map<string, number>();
+	for (const [position, projected] of projection.entries.entries()) {
+		const index = branchIndex.get(projected.sourceEntry.id);
+		if (index === undefined) {
+			return { ok: false, reason: "the saved branch changed unexpectedly" };
+		}
+		const isCovered = position === 0 || index < checkpoint.entryIndex;
+		for (const message of projected.messages) {
+			if (message.role === "system") continue;
+			const key = messageKey(message);
+			if (isCovered) {
+				covered.set(key, { message, count: (covered.get(key)?.count ?? 0) + 1 });
+			} else {
+				later.set(key, (later.get(key) ?? 0) + 1);
+			}
+		}
+	}
+
+	const present = new Map<string, number>();
+	const unknownByIdentity = new Map<string, number>();
+	for (const message of params.messages) {
+		const key = messageKey(message);
+		present.set(key, (present.get(key) ?? 0) + 1);
+		if (!covered.has(key) && !later.has(key)) {
+			const identity = messageIdentity(message);
+			unknownByIdentity.set(identity, (unknownByIdentity.get(identity) ?? 0) + 1);
+		}
+	}
