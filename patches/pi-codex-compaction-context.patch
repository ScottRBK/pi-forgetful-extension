diff --git a/packages/pi-codex-compaction/README.md b/packages/pi-codex-compaction/README.md
index bddefc5..8fd4961 100644
--- a/packages/pi-codex-compaction/README.md
+++ b/packages/pi-codex-compaction/README.md
@@ -37,6 +37,34 @@ Native checkpoints are persisted in `CompactionEntry.details`. Resume, forks, tr

 Compaction is fail-closed. If a native request fails, Pi's compaction is cancelled and the previous history remains intact. The extension never silently falls back to Pi text summarization. If a persisted native checkpoint is malformed or belongs to another Codex model, the next request is aborted rather than sending Pi's local marker to OpenAI.

+### Context from other extensions
+
+After a checkpoint, the `context` hook swaps the checkpoint and the saved messages it already
+covers for one transient marker message. Everything else Pi sends (messages other extensions
+added, messages they filtered out, edited tail messages) is kept as is. Just before the request,
+the marker is replaced by the checkpoint's replacement history. The marker is never saved to the
+session and is never sent to OpenAI.
+
+If the marker cannot be placed or found safely, the extension warns (a notification, or
+`console.warn` without a UI) and rebuilds the request from the saved session. The checkpoint is
+still used, but other extensions' context edits are lost for that request. Fallback cases:
+
+- another hook edited a saved message the checkpoint covers (removing one is fine)
+- duplicate saved messages that cannot be told apart
+- the checkpoint was written by an older version as a custom entry
+- a later hook removed, duplicated or altered the marker
+- the host Pi has no `buildSessionProjection` (before Pi 0.87)
+
+The warning shows once per session and checkpoint, not on every request. A new checkpoint, or a
+restarted session, warns again. The rebuild also ignores Pi `context_edit` entries (an existing
+limitation of the saved-branch rebuild); the normal path honours them.
+
+The marker is recognised only as a whole user message holding the exact form
+`[codex-native-checkpoint:<entryId>:<uuid>]`. Text that merely mentions the prefix is ordinary
+content. That exact form is reserved: if a request without a checkpoint still carries such a
+message, only that message is dropped. A user who types that exact form by hand loses that message.
+The pending marker is kept until the next context event, so a re-sent request resolves the same way.
+
 ## Configuration

 On Pi 0.84.4 and later, configure compaction through Pi in `~/.pi/agent/settings.json` or project-local `.pi/settings.json`:
@@ -64,3 +92,11 @@ The current conversation is sent to the ChatGPT Codex Responses endpoint. OpenAI
 Native checkpoints are model-specific. Switch back to the model that created the checkpoint before continuing. Provider switching is not a portability path because no textual summary is generated.

 Pi does not expose a finalized provider payload during `session_before_compact`. The extension mirrors Pi's Codex message conversion and combines it with the latest observed request shape to construct the compaction request. Extensions loaded later that independently rewrite provider payloads can therefore create order-dependent behavior.
+
+The opaque checkpoint is not filtered. Text that another extension injected before compaction
+and that ended up inside the checkpoint stays there. Only messages added after the checkpoint
+are controlled by context hooks. A hook that rewrites a covered saved message and changes its
+timestamp is seen as a removal plus an addition, so the new message is sent next to the checkpoint.
+
+Regression tests for context delivery: `npm run test:context` (`node --test`, Node 22.19+ runs
+the TypeScript directly; kept out of Bun's `*.test.ts` discovery on purpose).
diff --git a/packages/pi-codex-compaction/context-delivery.node.ts b/packages/pi-codex-compaction/context-delivery.node.ts
new file mode 100644
index 0000000..b8ad2ae
--- /dev/null
+++ b/packages/pi-codex-compaction/context-delivery.node.ts
@@ -0,0 +1,776 @@
+// Regression tests for context delivery after a native Codex checkpoint.
+//
+// Seam: registered extension handlers -> real SessionManager -> real pi-ai Codex provider.
+// Only the network is faked: the provider's onPayload hook records the final request and stops.
+// Runs with plain Node (>=22.19, native type stripping): npm run test:context
+// Not named *.test.ts on purpose, so Bun's auto-discovery leaves it alone.
+import assert from "node:assert/strict";
+import { describe, mock, test } from "node:test";
+import { convertToLlm, SessionManager } from "@earendil-works/pi-coding-agent";
+import { stream } from "@earendil-works/pi-ai/api/openai-codex-responses";
+import { registerCodexCompactionExtension } from "./index.ts";
+import {
+	modelKey,
+	NATIVE_COMPACTION_KIND,
+	NATIVE_COMPACTION_VERSION,
+} from "./native-compaction.ts";
+
+type Hook = (event: any, ctx: any) => any;
+type Extension = (pi: any) => void;
+
+const codex = {
+	id: "gpt-test",
+	name: "GPT Test",
+	api: "openai-codex-responses",
+	provider: "openai-codex",
+	baseUrl: "http://127.0.0.1:1",
+	reasoning: true,
+	input: ["text"],
+	contextWindow: 200_000,
+	maxTokens: 16_384,
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+} as any;
+
+const claude = { ...codex, id: "claude-test", provider: "anthropic", api: "anthropic-messages" };
+const MARKER_PREFIX = "[codex-native-checkpoint:";
+const LOCAL_SUMMARY = "OpenAI Codex native compaction checkpoint (local).";
+
+function jwt(): string {
+	const body = Buffer.from(JSON.stringify({
+		"https://api.openai.com/auth": { chatgpt_account_id: "account-123" },
+	})).toString("base64url");
+	return `header.${body}.signature`;
+}
+
+// ---- session builders -------------------------------------------------------------------------
+
+const user = (text: string, timestamp: number) =>
+	({ role: "user", content: [{ type: "text", text }], timestamp }) as any;
+
+const assistant = (blocks: any[], timestamp: number) => ({
+	role: "assistant",
+	content: blocks,
+	api: codex.api,
+	provider: codex.provider,
+	model: codex.id,
+	usage: {
+		input: 0, output: 0, cacheRead: 0, cacheWrite: 0, totalTokens: 0,
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+	},
+	stopReason: "stop",
+	timestamp,
+}) as any;
+
+const say = (text: string, timestamp: number) =>
+	assistant([{ type: "text", text }], timestamp);
+
+function details(label: string, model = codex) {
+	return {
+		kind: NATIVE_COMPACTION_KIND,
+		version: NATIVE_COMPACTION_VERSION,
+		modelKey: modelKey(model),
+		replacementHistory: [
+			{ role: "user", content: [{ type: "input_text", text: `retained by ${label}` }] },
+			{ type: "compaction", id: `cmp_${label}`, encrypted_content: `opaque-${label}` },
+		],
+	};
+}
+
+/** old(1000) answer(1001) kept(1002) kept-answer(1003) [compaction] tail(2000..2002) */
+function seedSession(options: { tail?: boolean } = {}) {
+	const sm = SessionManager.inMemory("/tmp/pi-codex-compaction-test");
+	sm.appendMessage(user("old question", 1000));
+	const oldAnswer = sm.appendMessage(say("old answer", 1001));
+	const kept = sm.appendMessage(user("kept question", 1002));
+	sm.appendMessage(say("kept answer", 1003));
+	const checkpoint = sm.appendCompaction(LOCAL_SUMMARY, kept, 5000, details("one"), true);
+	if (options.tail !== false) {
+		sm.appendMessage(user("tail question", 2000));
+		sm.appendMessage(say("tail answer", 2001));
+		sm.appendMessage(user("latest question", 2002));
+	}
+	return { sm, kept, oldAnswer, checkpoint };
+}
+
+// ---- runtime: handlers + provider recording --------------------------------------------------
+
+function createRuntime(
+	options: { hasUI?: boolean; model?: any; view?: (sm: SessionManager) => any } = {},
+) {
+	const hooks = new Map<string, Hook[]>();
+	const notices: string[] = [];
+	const errors: string[] = [];
+	let model = options.model ?? codex;
+	const pi = {
+		on: (name: string, hook: Hook) => {
+			hooks.set(name, [...(hooks.get(name) ?? []), hook]);
+		},
+		getAllTools: () => [],
+		getActiveTools: () => [],
+		registerEntryRenderer: () => {},
+		appendEntry: () => {},
+		sendUserMessage: () => {},
+	};
+	const use = (extension: Extension) => extension(pi);
+	const codexExtension: Extension = (api) => registerCodexCompactionExtension(api, "1.0.0");
+
+	const ctxFor = (sm: SessionManager) => ({
+		model,
+		mode: options.hasUI === false ? "print" : "tui",
+		hasUI: options.hasUI !== false,
+		cwd: "/tmp/pi-codex-compaction-test",
+		ui: { notify: (message: string) => notices.push(message) },
+		abort: () => {},
+		isProjectTrusted: () => false,
+		getSystemPrompt: () => "You are Codex.",
+		sessionManager: options.view ? options.view(sm) : sm,
+	});
+
+	// Mirrors the runner: a throwing handler is recorded and skipped.
+	type Pick = (event: any, result: any) => void;
+	const run = async (name: string, event: any, ctx: any, pick: Pick) => {
+		for (const hook of hooks.get(name) ?? []) {
+			try {
+				pick(event, await hook(event, ctx));
+			} catch (error) {
+				errors.push(error instanceof Error ? error.message : String(error));
+			}
+		}
+	};
+
+	const runContext = async (sm: SessionManager, messages?: any[]) => {
+		const source = messages ?? sm.buildSessionContext().messages;
+		const event = { type: "context", messages: structuredClone(source) };
+		await run("context", event, ctxFor(sm), (e, result) => {
+			if (result?.messages) e.messages = result.messages;
+		});
+		return event.messages as any[];
+	};
+
+	/** Sends [system, ...messages] through the real Codex provider and returns the final body. */
+	const runRequest = async (sm: SessionManager, messages: any[], rawPayload?: any) => {
+		let body: any;
+		const ctx = ctxFor(sm);
+		const system = { role: "system", content: "You are Codex.", timestamp: 1 };
+		const llm = [system, ...convertToLlm(messages)];
+		const events = stream(model, { messages: llm } as any, {
+			apiKey: jwt(),
+			onPayload: async (payload: any) => {
+				const event = { type: "before_provider_request", payload: rawPayload ?? payload };
+				await run("before_provider_request", event, ctx, (e, result) => {
+					if (result !== undefined) e.payload = result;
+				});
+				body = event.payload;
+				throw new Error("stop before network");
+			},
+		} as any);
+		for await (const _ of events) { /* drain */ }
+		return body;
+	};
+
+	const turn = async (sm: SessionManager) => runRequest(sm, await runContext(sm));
+	const fire = async (name: string, sm: SessionManager, event: any = {}) =>
+		run(name, event, ctxFor(sm), () => {});
+
+	return {
+		use, codexExtension, runContext, runRequest, turn, fire, notices, errors,
+		setModel: (next: any) => { model = next; },
+	};
+}
+
+// ---- wire inspection (independent of the code under test) ------------------------------------
+
+function wire(payload: any): string[] {
+	return (payload.input as any[]).map((item) => {
+		if (item.type === "compaction") return `<compaction:${item.encrypted_content}>`;
+		if (item.type === "function_call") return `call:${item.call_id}`;
+		if (item.type === "function_call_output") return `out:${item.call_id}:${item.output}`;
+		if (item.type === "message") return item.content.map((part: any) => part.text).join("");
+		return item.content.map((part: any) => part.text).join("");
+	});
+}
+
+const messageText = (message: any) =>
+	typeof message.content === "string"
+		? message.content
+		: (message.content ?? []).map((part: any) => part.text ?? "").join("");
+
+const recall: Extension = (pi) =>
+	pi.on("context", (event: any) => {
+		const messages = [...event.messages];
+		messages.splice(messages.length - 1, 0, {
+			role: "custom", customType: "forgetful", content: "RECALL", display: false,
+			timestamp: 2002,
+		});
+		return { messages };
+	});
+
+const dropText = (text: string): Extension => (pi) =>
+	pi.on("context", (event: any) => ({
+		messages: event.messages.filter((m: any) => !messageText(m).includes(text)),
+	}));
+
+const REWRITTEN_TAIL = [
+	"retained by one", "<compaction:opaque-one>", "tail question", "tail answer", "latest question",
+];
+
+describe("native checkpoint context delivery", () => {
+	for (const order of ["before", "after"] as const) {
+		test(`delivers context injected by another hook registered ${order} codex`, async () => {
+			const { sm } = seedSession();
+			const rt = createRuntime();
+			if (order === "before") rt.use(recall);
+			rt.use(rt.codexExtension);
+			if (order === "after") rt.use(recall);
+
+			const payload = await rt.turn(sm);
+
+			assert.deepEqual(wire(payload), [
+				"retained by one", "<compaction:opaque-one>", "tail question", "tail answer",
+				"RECALL", "latest question",
+			]);
+			assert.deepEqual(rt.notices, []);
+		});
+
+		test(`keeps a tail message filtered by a hook registered ${order} codex out`, async () => {
+			const { sm } = seedSession();
+			const rt = createRuntime();
+			if (order === "before") rt.use(dropText("tail question"));
+			rt.use(rt.codexExtension);
+			if (order === "after") rt.use(dropText("tail question"));
+
+			const payload = await rt.turn(sm);
+
+			assert.deepEqual(wire(payload), [
+				"retained by one", "<compaction:opaque-one>", "tail answer", "latest question",
+			]);
+			assert.deepEqual(rt.notices, []);
+		});
+	}
+
+	test("a retained record filtered by an earlier hook stays absent quietly", async () => {
+		const { sm } = seedSession();
+		const rt = createRuntime();
+		rt.use(dropText("kept question"));
+		rt.use(recall);
+		rt.use(rt.codexExtension);
+
+		const payload = await rt.turn(sm);
+
+		assert.deepEqual(wire(payload), [
+			"retained by one", "<compaction:opaque-one>", "tail question", "tail answer",
+			"RECALL", "latest question",
+		]);
+		assert.deepEqual(rt.notices, []);
+	});
+
+	test("sends exactly one compaction item and never replays retained history", async () => {
+		const { sm } = seedSession();
+		const rt = createRuntime();
+		rt.use(rt.codexExtension);
+
+		const payload = await rt.turn(sm);
+
+		const text = JSON.stringify(payload);
+		assert.equal(payload.input.filter((item: any) => item.type === "compaction").length, 1);
+		const replays = [
+			"old question", "old answer", "kept question", "kept answer", LOCAL_SUMMARY,
+		];
+		for (const replayed of replays) {
+			assert.equal(text.includes(replayed), false, `${replayed} was replayed`);
+		}
+		assert.equal(text.includes(MARKER_PREFIX), false);
+		assert.equal(payload.instructions, "You are Codex.");
+		assert.deepEqual(wire(payload), REWRITTEN_TAIL);
+	});
+
+	test("warns and falls back when an earlier hook edits a retained record", async () => {
+		const { sm } = seedSession();
+		const rt = createRuntime();
+		rt.use((pi) => pi.on("context", (event: any) => ({
+			messages: event.messages.map((m: any) =>
+				m.role === "user" && messageText(m) === "kept question"
+					? { ...m, content: [{ type: "text", text: "EDITED kept question" }] }
+					: m),
+		})));
+		rt.use(rt.codexExtension);
+
+		const payload = await rt.turn(sm);
+
+		const text = JSON.stringify(payload);
+		assert.equal(text.includes("EDITED"), false);
+		assert.equal(text.includes("kept question"), false);
+		assert.equal(payload.input.filter((item: any) => item.type === "compaction").length, 1);
+		assert.deepEqual(wire(payload), REWRITTEN_TAIL);
+		assert.equal(rt.notices.length, 1);
+		assert.match(rt.notices[0]!, /edited/i);
+	});
+
+	test("identical duplicate messages are matched by count", async () => {
+		const sm = SessionManager.inMemory("/tmp/pi-codex-compaction-test");
+		const kept = sm.appendMessage(user("same", 1000));
+		sm.appendCompaction(LOCAL_SUMMARY, kept, 5000, details("one"), true);
+		sm.appendMessage(user("same", 1000));
+		sm.appendMessage(user("latest question", 2002));
+		const rt = createRuntime();
+		rt.use(rt.codexExtension);
+
+		const payload = await rt.turn(sm);
+
+		assert.deepEqual(wire(payload), [
+			"retained by one", "<compaction:opaque-one>", "same", "latest question",
+		]);
+		assert.deepEqual(rt.notices, []);
+	});
+
+	test("an ambiguous duplicate with a removed copy falls back with a warning", async () => {
+		const sm = SessionManager.inMemory("/tmp/pi-codex-compaction-test");
+		const kept = sm.appendMessage(user("same", 1000));
+		sm.appendCompaction(LOCAL_SUMMARY, kept, 5000, details("one"), true);
+		sm.appendMessage(user("same", 1000));
+		sm.appendMessage(user("latest question", 2002));
+		const rt = createRuntime();
+		let removed = false;
+		rt.use((pi) => pi.on("context", (event: any) => ({
+			messages: event.messages.filter((m: any) => {
+				if (!removed && messageText(m) === "same") return (removed = true) && false;
+				return true;
+			}),
+		})));
+		rt.use(rt.codexExtension);
+
+		const payload = await rt.turn(sm);
+
+		assert.deepEqual(wire(payload), [
+			"retained by one", "<compaction:opaque-one>", "same", "latest question",
+		]);
+		assert.equal(rt.notices.length, 1);
+	});
+
+	test("tool calls and results after the checkpoint are unchanged", async () => {
+		const { sm } = seedSession({ tail: false });
+		sm.appendMessage(user("read it", 2000));
+		sm.appendMessage(assistant(
+			[{ type: "toolCall", id: "call_1|fc_1", name: "read", arguments: { path: "a.txt" } }],
+			2001,
+		));
+		sm.appendMessage({
+			role: "toolResult", toolCallId: "call_1|fc_1", toolName: "read",
+			content: [{ type: "text", text: "file body" }], isError: false, timestamp: 2002,
+		} as any);
+		sm.appendMessage(user("latest question", 2003));
+		const rt = createRuntime();
+		rt.use(rt.codexExtension);
+
+		const payload = await rt.turn(sm);
+
+		assert.deepEqual(wire(payload), [
+			"retained by one", "<compaction:opaque-one>", "read it", "call:call_1",
+			"out:call_1:file body", "latest question",
+		]);
+		assert.equal(payload.input.find((item: any) => item.type === "function_call").id, "fc_1");
+	});
+
+	test("sessions without a checkpoint are untouched and keep injected context", async () => {
+		const sm = SessionManager.inMemory("/tmp/pi-codex-compaction-test");
+		sm.appendMessage(user("first", 1000));
+		sm.appendMessage(say("answer", 1001));
+		sm.appendMessage(user("latest question", 1002));
+		const rt = createRuntime();
+		rt.use(rt.codexExtension);
+		rt.use(recall);
+
+		const payload = await rt.turn(sm);
+
+		assert.deepEqual(wire(payload), ["first", "answer", "RECALL", "latest question"]);
+		assert.deepEqual(rt.notices, []);
+	});
+
+	test("non-Codex models are not given a checkpoint marker", async () => {
+		const { sm } = seedSession();
+		const rt = createRuntime({ model: claude });
+		rt.use(rt.codexExtension);
+
+		const messages = await rt.runContext(sm);
+
+		assert.equal(messages.some((m) => messageText(m).includes(MARKER_PREFIX)), false);
+		assert.equal(messages.some((m) => m.role === "compactionSummary"), false);
+		assert.deepEqual(rt.notices, []);
+	});
+
+	test("a checkpoint for another model keeps the existing blocked behaviour", async () => {
+		const { sm } = seedSession();
+		const rt = createRuntime({ model: { ...codex, id: "gpt-other" } });
+		rt.use(rt.codexExtension);
+
+		const payload = await rt.turn(sm);
+
+		assert.deepEqual(payload.input, []);
+		assert.equal(JSON.stringify(payload).includes(MARKER_PREFIX), false);
+	});
+
+	test("the marker never reaches the saved session", async () => {
+		const { sm } = seedSession();
+		const rt = createRuntime();
+		rt.use(rt.codexExtension);
+
+		const messages = await rt.runContext(sm);
+
+		assert.equal(messages.filter((m) => messageText(m).startsWith(MARKER_PREFIX)).length, 1);
+		assert.equal(JSON.stringify(sm.getEntries()).includes(MARKER_PREFIX), false);
+	});
+
+	test("warns and rebuilds when a later hook removes the marker", async () => {
+		const { sm } = seedSession();
+		const rt = createRuntime();
+		rt.use(rt.codexExtension);
+		rt.use(dropText(MARKER_PREFIX));
+
+		const payload = await rt.turn(sm);
+
+		assert.deepEqual(wire(payload), REWRITTEN_TAIL);
+		assert.equal(JSON.stringify(payload).includes(MARKER_PREFIX), false);
+		assert.equal(rt.notices.length, 1);
+		assert.match(rt.notices[0]!, /marker/i);
+	});
+
+	test("warns and rebuilds when a later hook duplicates the marker", async () => {
+		const { sm } = seedSession();
+		const rt = createRuntime();
+		rt.use(rt.codexExtension);
+		rt.use((pi) => pi.on("context", (event: any) => ({
+			messages: event.messages.flatMap((m: any) =>
+				messageText(m).startsWith(MARKER_PREFIX) ? [m, structuredClone(m)] : [m]),
+		})));
+
+		const payload = await rt.turn(sm);
+
+		assert.deepEqual(wire(payload), REWRITTEN_TAIL);
+		assert.equal(JSON.stringify(payload).includes(MARKER_PREFIX), false);
+		assert.equal(rt.notices.length, 1);
+	});
+
+	test("without a UI the fallback is reported on the console", async () => {
+		const warn = mock.method(console, "warn", () => {});
+		try {
+			const { sm } = seedSession();
+			const rt = createRuntime({ hasUI: false });
+			rt.use(rt.codexExtension);
+			rt.use(dropText(MARKER_PREFIX));
+
+			await rt.turn(sm);
+
+			assert.equal(warn.mock.callCount(), 1);
+			assert.match(String(warn.mock.calls[0]!.arguments[0]), /marker/i);
+		} finally {
+			warn.mock.restore();
+		}
+	});
+
+	test("a legacy custom-entry checkpoint falls back with a warning", async () => {
+		const sm = SessionManager.inMemory("/tmp/pi-codex-compaction-test");
+		sm.appendMessage(user("old question", 1000));
+		sm.appendCustomEntry(NATIVE_COMPACTION_KIND, details("legacy"));
+		sm.appendMessage(user("latest question", 2002));
+		const rt = createRuntime();
+		rt.use(rt.codexExtension);
+
+		const payload = await rt.turn(sm);
+
+		assert.deepEqual(wire(payload), [
+			"retained by legacy", "<compaction:opaque-legacy>", "latest question",
+		]);
+		assert.equal(rt.notices.length, 1);
